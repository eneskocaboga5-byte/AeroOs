#!/bin/sh
if [ -z "$1" ] || [ -z "$2" ]; then
    echo "Aero Package Manager v2.0 (AeroOs Native Source)"
    echo "Kullanim: apm install <paket_adi>"
    exit 1
fi

if [ "$1" = "install" ]; then
    echo "[apm] $2 paketi yerel AeroOs deposundan indiriliyor..."
    
    # Bilgisayarındaki Python sunucusunun QEMU içindeki adresi
    SERVER_URL="http://10.0.2.2:8080"
    
    # Paketi .tar.gz formatında çekiyoruz
    wget "$SERVER_URL/$2.tar.gz" -O "/tmp/$2.tar.gz" 2>/dev/null
    
    if [ $? -eq 0 ]; then
        echo "[apm] Paket indirildi. Kurulum yapiliyor..."
        
        # Sıkıştırmayı tamamen BusyBox yerel komutlarıyla kök dizine (/) açıyoruz
        tar -xzf "/tmp/$2.tar.gz" -C /
        rm -f "/tmp/$2.tar.gz"
        
        echo "===================================================="
        echo "[ OK ] $2 paketi basariyla kuruldu!"
        echo "Artik terminalde '$2' yazarak calistirabilirsin."
        echo "===================================================="
    else
        echo "[ HATA ] $2 paketi depoda bulunamadi veya sunucu kapali."
        rm -f "/tmp/$2.tar.gz"
    fi
fi
